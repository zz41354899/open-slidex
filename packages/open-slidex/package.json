{
  "name": "open-slidex",
  "version": "0.3.4",
  "description": "Create a local-first MDX presentation workspace.",
  "type": "module",
  "bin": {
    "open-slidex": "dist/cli.mjs"
  },
  "exports": {
    "./cli": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "runtime",
    "template",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-open-slidex-package.mjs",
    "test": "node --import tsx --test src/*.test.ts && node --check dist/cli.mjs && node --check dist/create.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "slidex",
    "open-slidex",
    "presentation",
    "starter",
    "mdx"
  ],
